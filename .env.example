# 복사해서 .env로 쓴다: cp .env.example .env
# docker compose(infra/)와 백엔드(apps/api)가 함께 읽는다. 값이 없으면 아래와 같은 기본값을 쓴다.

# PostgreSQL
POSTGRES_DB=livestream
POSTGRES_USER=livestream
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# 테스트 계정 (streamer1, viewer1). 로컬과 시연 서버에서만 켠다.
TEST_ACCOUNTS_ENABLED=true
TEST_ACCOUNT_PASSWORD=test1234
